<?xml version="1.0" encoding="utf-8"?>
<!-- The bridge is plain HTTP on the LAN (spec §4). Android network-security-config
     can only allowlist literal domains, not user-configured IPs, so cleartext is
     permitted globally. The bearer secret authenticates every request; Tailscale
     is the documented upgrade path for transport privacy. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
